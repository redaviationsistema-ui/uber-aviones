APP_NAME="Uber Aviones Testing"
APP_ENV=testing
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Base PostgreSQL exclusiva para pruebas. Nunca reutilizar desarrollo o producción.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=uber_aviones_testing
DB_USERNAME=uber_aviones_testing
DB_PASSWORD=
DB_SSLMODE=prefer
DB_PERSISTENT=false

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=null

# Integraciones reales se ejecutan por separado con infraestructura exclusiva.
RUN_S3_INTEGRATION_TESTS=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
