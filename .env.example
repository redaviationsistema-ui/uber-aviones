APP_NAME=UberAviones
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://uber-aviones.onrender.com
APP_TIMEZONE=America/Mexico_City

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

PROFILE_API_REQUESTS=false

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=uber_aviones
DB_USERNAME=postgres
DB_PASSWORD=
DB_CONNECT_TIMEOUT=5
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.redskyg.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3

CACHE_STORE=file
QUEUE_CONNECTION=sync

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@uberaviones.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=red-aviation-images
AWS_URL=https://red-aviation-images.s3.us-east-1.amazonaws.com
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_EC2_METADATA_DISABLED=true

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_SECURE=true
CLOUDINARY_FOLDER=red-aviation

STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
FRONTEND_URL=https://redskyg.com/renta
SANCTUM_STATEFUL_DOMAINS=redskyg.com,www.redskyg.com,localhost:5173,127.0.0.1:5173
WIRE_BANK_NAME="Tu banco"
WIRE_BANK_BENEFICIARY="Red Aviation"
WIRE_BANK_ACCOUNT=1234567890
WIRE_BANK_CLABE=012345678901234567
WIRE_BANK_SWIFT=ABCDEF12

VITE_APP_NAME="${APP_NAME}"
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none
AUTH_TOKEN_COOKIE=red_aviation_session
AUTH_TOKEN_TTL_MINUTES=43200
AUTH_TOKEN_SAME_SITE=none
CORS_ALLOWED_ORIGINS=https://redskyg.com,https://www.redskyg.com,http://localhost:5173,http://127.0.0.1:5173
